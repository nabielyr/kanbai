# Copy this file to .env and fill in the values.
# Never commit .env — it is ignored by git.
# Only NEXT_PUBLIC_* values are exposed to the browser; everything else stays on the server.

# --- AI (server-only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Rate limiting (server-only) ---
# Upstash console > your Redis database > REST API: the URL and token.
# Leave empty in local dev: usage is then counted in memory (resets on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string; IPs are only stored as salted hashes.
IP_HASH_SALT=change-me
# Free "Chunk it" tries for guests before they're asked to log in (only when login is set up).
GUEST_FREE_CHUNKS=3
RATE_LIMIT_USER_PER_MINUTE=5
RATE_LIMIT_USER_PER_DAY=30
RATE_LIMIT_GLOBAL_PER_DAY=300

# --- Supabase (public by design; Row Level Security protects the data) ---
# Project Settings > API Keys: the publishable key (sb_publishable_...) or the legacy anon key.
# Leave both empty to run without login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
